# Create an application/bot at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
DISCORD_GUILD_ID=your_test_or_server_guild_id

# Enable Developer Mode in Discord, then right-click each channel/role and Copy ID.
LIVE_SERVERS_CHANNEL_ID=000000000000000000
SERVER_COMMANDS_CHANNEL_ID=000000000000000000
CARMINE_ROLE_ID=000000000000000000
XP_ROLE_ID=000000000000000000
STAFF_REPORTS_CHANNEL_ID=000000000000000000
MODERATOR_ROLE_ID=000000000000000000

# Optional. Relative paths are resolved from the process working directory.
DATABASE_PATH=./data/live-servers.sqlite
EXPIRATION_POLL_MS=15000
